{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "build",
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
  },
  "include": ["src/**/*", "cli/**/*"],
  "exclude": ["node_modules", "test", "build"]
}
